{
  "name": "benchmark",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "start:go": "expo start --go",
    "start:tunnel": "expo start --go --tunnel",
    "start:dev": "expo start --dev-client",
    "start:dev:tunnel": "expo start --dev-client --tunnel",
    "ios": "expo start --go --ios",
    "android": "expo start --go --android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "smoke:live": "jest --testMatch \"<rootDir>/smoke/**/*.live.test.ts\"",
    "dev:api": "node --experimental-transform-types --no-warnings scripts/dev-api.ts",
    "record:places": "node --experimental-transform-types --no-warnings scripts/record-places.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.20",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.29",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts",
      "<rootDir>/tests/**/*.test.tsx"
    ]
  }
}

# Copy to .env (git-ignored). Never commit real values.

## Server-side only. Read by `npm run dev:api` (and later set as a Supabase function secret).
## Must NOT be given an EXPO_PUBLIC_ prefix: it must never reach the app bundle.
ORS_API_KEY=

## Public client configuration (safe to ship in the app).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

## Optional: full URL of a deployed route service. When unset, a development build talks to
## `npm run dev:api` on the computer running Metro (port 8787).
# EXPO_PUBLIC_OUTING_API_URL=
